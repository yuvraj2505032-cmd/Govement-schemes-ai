# Server-side AI/search credentials. Never expose these through VITE_* variables.
# Gemini is the primary assistant; Groq is used when Gemini is unavailable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
TAVILY_API_KEY="your-tavily-api-key"
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"

# Public browser configuration; protected by Supabase Auth and row-level security.
# Never use a Supabase service-role key here.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# Used by the optional FastAPI backend.
CORS_ORIGINS="http://localhost:5173,https://your-production-domain.example"
